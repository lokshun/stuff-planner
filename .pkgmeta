# Empaquetage par le packager BigWigs (CurseForge). Voie de référence : `make zip`
# (bibliothèques figées par tools/fetch_libs.sh). StuffPlanner_Data est généré
# (`make data`, hors git) : le produire avant de lancer le packager.
# Multi-TOC : chaque addon a son TOC `_Camelot` (Forever) et `_Vanilla` (Classic Era).
package-as: StuffPlanner

move-folders:
  StuffPlanner/StuffPlanner: StuffPlanner
  StuffPlanner/StuffPlanner_Data: StuffPlanner_Data

externals:
  StuffPlanner/Libs/LibStub:
    url: https://repos.wowace.com/wow/libstub/trunk
    tag: latest
  StuffPlanner/Libs/CallbackHandler-1.0:
    url: https://repos.wowace.com/wow/callbackhandler/trunk/CallbackHandler-1.0
    tag: latest
  StuffPlanner/Libs/AceAddon-3.0: https://repos.wowace.com/wow/ace3/trunk/AceAddon-3.0
  StuffPlanner/Libs/AceBucket-3.0: https://repos.wowace.com/wow/ace3/trunk/AceBucket-3.0
  StuffPlanner/Libs/AceEvent-3.0: https://repos.wowace.com/wow/ace3/trunk/AceEvent-3.0
  StuffPlanner/Libs/AceLocale-3.0: https://repos.wowace.com/wow/ace3/trunk/AceLocale-3.0
  StuffPlanner/Libs/AceSerializer-3.0: https://repos.wowace.com/wow/ace3/trunk/AceSerializer-3.0
  StuffPlanner/Libs/AceTimer-3.0: https://repos.wowace.com/wow/ace3/trunk/AceTimer-3.0
  StuffPlanner/Libs/AceComm-3.0: https://repos.wowace.com/wow/ace3/trunk/AceComm-3.0
  StuffPlanner/Libs/LibDeflate:
    url: https://github.com/SafeteeWoW/LibDeflate
    tag: 1.0.2-release
  StuffPlanner/Libs/LibDataBroker-1.1: https://github.com/tekkub/libdatabroker-1-1
  StuffPlanner/Libs/LibDBIcon-1.0: https://repos.wowace.com/wow/libdbicon-1-0/trunk/LibDBIcon-1.0
  StuffPlanner/Libs/HereBeDragons-2.0:
    url: https://repos.wowace.com/wow/herebedragons/trunk
    tag: 2.18-release

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

ignore:
  - docs
  - tests
  - tools
  - build
  - Makefile
  - CLAUDE.md
  - README.md
  - .busted
  - .luacheckrc
